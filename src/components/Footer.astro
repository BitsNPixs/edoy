---
import { siteData } from '../data/site.js';

const foot = siteData.footer;
---

<!-- ============ FOOTER ============ -->
<footer class="footer" id="footer">
    <div class="footer__inner">

        <a class="footer__brand" href={foot.logo.href}>
            <img class="footer__brand-img" src={foot.logo.src} alt={foot.logo.alt}>
        </a>

        <nav class="footer__nav">
            {foot.columns.map((col) => (
                <div class="footer__col">
                    <h3 class="footer__title">{col.title}</h3>
                    <ul class="footer__list">
                        {col.links.map((l) => (
                            <li class="footer__item">
                                <a class="footer__link" href={l.href}>{l.label}</a>
                            </li>
                        ))}
                    </ul>
                </div>
            ))}
        </nav>

        <div class="footer__mark">
            <img class="footer__mark-img" src={foot.wordmark.src} alt={foot.wordmark.alt}>
        </div>

    </div>
</footer>
